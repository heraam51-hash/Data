```matlab
% Program 5: Variables and Operators in MATLAB
clc;
clear;
close all;

% Initialize variables
a = 20;
b = 10;

% Arithmetic operators
addition = a + b;
subtraction = a - b;
multiplication = a * b;
division = a / b;
modulus = mod(a, b);

